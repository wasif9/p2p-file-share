    "version": "0.2.0",
    "configurations": [
        {
            "name": "reverse proxy",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/reverse-proxy",
            "args": [
                "${workspaceFolder}/superconfig.json"
            ]
        },
        {
            "name": "db manager",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/db-manager",
            "args": [
                "${workspaceFolder}/superconfig.json",
                "0"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Run both servers",
            "configurations": [
                "reverse proxy",
                "db manager"
            ]
        }
    ]
}